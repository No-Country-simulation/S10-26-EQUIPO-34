# Database Configuration (PostgreSQL 17 via Docker)
POSTGRES_USER=repusense
POSTGRES_PASSWORD=repusense_secret
POSTGRES_DB=repusense_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://repusense:repusense_secret@localhost:5432/repusense_db?schema=public

# NestJS API
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api
